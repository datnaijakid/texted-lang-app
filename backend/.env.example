# Texted Backend Environment Variables
# Copy to .env and fill in values for your environment.

# Core / Environment
ENVIRONMENT=development
# For production, set to: production

# Database
# Local dev default: sqlite:///./texted.db
# Production (Neon PostgreSQL): postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=sqlite:///./texted.db

# Authentication & Sessions
JWT_SECRET=change-me-to-a-strong-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-texted-app.vercel.app

# Cookie Security (set to True when deployed with HTTPS)
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# LLM Provider (mock | anthropic | openai)
# "mock" runs deterministically offline without API keys.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email Delivery (EmailJS REST API integration)
# Leave empty in local dev to log verification and reset codes to the terminal console
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:5173?session_id={CHECKOUT_SESSION_ID}&upgraded=true
STRIPE_CANCEL_URL=http://localhost:5173

# Grading
FUZZY_MATCH_THRESHOLD=80
